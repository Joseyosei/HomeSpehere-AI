{
  "expo": {
    "name": "HomeSphere AI",
    "slug": "homesphere-ai",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.homesphere.ai",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your trusted HomeSphere home gateway."
      }
    },
    "android": {
      "package": "com.homesphere.ai"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}