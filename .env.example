# Optional local configuration. Keep real credentials out of Git.
# HS_HA_URL=https://homeassistant.example.local:8123
# HS_HA_TOKEN=
# HS_HA_TOKEN_FILE=
# HS_MQTT_URL=mqtts://broker.example.local:8883
# HS_MQTT_USERNAME=
# HS_MQTT_PASSWORD=
# HS_MQTT_PASSWORD_FILE=
# HS_HA_POLL_MS=15000
HS_MAPPINGS='[{"adapter":"ha","key":"sensor.site_power","device":"meter","name":"Site meter","metric":"consumption"},{"adapter":"mqtt","key":"home/living/temperature","device":"climate","name":"Living room","metric":"temperature"}]'

# Local Ollama (disabled by default)
# HS_AI_ENABLED=1
# HS_OLLAMA_URL=http://127.0.0.1:11434
# HS_OLLAMA_MODEL=qwen2.5:3b

# Optional energy assumptions (currency units, NOT pence; use actual tariff)
# HS_ENERGY_CURRENCY=GBP
# HS_IMPORT_RATE=
# HS_EXPORT_RATE=
# HS_STANDING_CHARGE=
# HS_CARBON_FACTOR=

# Automation (disarmed at every startup; simulation default)
# HS_AUTOMATION_ADMIN_TOKEN=
# HS_AUTOMATION_LIGHTS='["light.demo"]'
# HS_AUTOMATION_LIVE=0
# HS_AUTOMATION_HA_URL=https://ha.example.local:8123
# HS_AUTOMATION_HA_TOKEN=

# First owner bootstrap: generate a random token, then remove after setup
# HS_SETUP_TOKEN=
# HS_SECURE_COOKIE=0
